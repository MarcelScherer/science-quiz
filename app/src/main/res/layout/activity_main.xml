<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/quiz_background"
    android:gravity="center">

    <!-- Fachbereich als kleine Überschrift -->
    <TextView
        android:id="@+id/tvDiscipline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISZIPLIN"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#00796B"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <!-- Die Entdeckung (Die Frage) -->
    <TextView
        android:id="@+id/tvDiscovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Was ist die Entdeckung?"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:background="@color/quiz_background"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        android:textStyle="bold" />

    <!-- Die Buttons -->
    <Button
        android:id="@+id/btnOpt1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:text="Antwort 1" />

    <Button
        android:id="@+id/btnOpt2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:text="Antwort 2" />

    <Button
        android:id="@+id/btnOpt3"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:text="Antwort 3" />

    <Button
        android:id="@+id/btnOpt4"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:text="Antwort 4" />

</LinearLayout>